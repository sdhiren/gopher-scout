# All settings are optional; defaults live in src/gopher_scout/config.py.
# Copy to `.env` to override.

# GitHub token. If unset, `gh auth token` is used.
# GS_GITHUB_TOKEN=

# Claude model + effort per agent.
# GS_MODEL=claude-opus-5-5
# GS_ANALYST_EFFORT=high
# GS_CRITIC_EFFORT=medium
# GS_IMPLEMENTER_EFFORT=high
# GS_REVIEWER_EFFORT=medium

# Hard USD ceiling for a single agent run.
# GS_MAX_BUDGET_USD_PER_RUN=5.0

# How many ideas the Analyst may propose per project.
# GS_MAX_IDEAS_PER_PROJECT=5

# Where `go build` / `go test` run during review: auto | docker | local
# GS_SANDBOX=auto
# GS_DOCKER_IMAGE=golang:1.27

# Implementer <-> Reviewer fix loop.
# GS_MAX_IMPLEMENTATION_ATTEMPTS=3
